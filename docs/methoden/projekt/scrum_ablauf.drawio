        </mxCell>
        <mxCell id="daily_scrum" value="&lt;b&gt;Daily Scrum&lt;/b&gt;&lt;br&gt;15 Minuten: Hindernisse&lt;br&gt;benennen, nicht lösen" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#22303C;" vertex="1" parent="sprint">
