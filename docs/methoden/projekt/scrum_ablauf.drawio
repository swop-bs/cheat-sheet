        <mxCell id="sprint_planning" value="&lt;b&gt;Sprint Planning&lt;/b&gt;&lt;br&gt;Was wird fertig — und wie?" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#22303C;" vertex="1" parent="sprint">
          <mxGeometry x="20" y="40" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="sprint_backlog" value="&lt;b&gt;Sprint Backlog&lt;/b&gt;&lt;br&gt;ausgewählte Einträge&lt;br&gt;samt Plan (Team)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#22303C;" vertex="1" parent="sprint">
