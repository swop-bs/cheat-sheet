        </mxCell>
        <mxCell id="increment" value="&lt;b&gt;Increment&lt;/b&gt;&lt;br&gt;brauchbares Ergebnis&lt;br&gt;am Sprintende, erfüllt die&lt;br&gt;Definition of Done" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#22303C;" vertex="1" parent="sprint">
