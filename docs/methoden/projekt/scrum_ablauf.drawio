        </mxCell>
        <mxCell id="product_backlog" value="&lt;b&gt;Product Backlog&lt;/b&gt;&lt;br&gt;alle bekannten&lt;br&gt;Anforderungen, nach&lt;br&gt;Nutzen geordnet&lt;br&gt;(Product Owner)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#22303C;" vertex="1" parent="1">
          <mxGeometry x="0" y="95" width="140" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="sprint" value="Sprint · 1 bis 4 Wochen, immer gleich lang" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#0E7490;strokeWidth=1.5;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#22303C;" vertex="1" parent="1">
